# FinanceBrain scraper keys — copy to .env.local and fill in values
# .env.local is gitignored; never commit real keys.

# Financial Modeling Prep — financials, price data, transcripts
# https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_key_here

# twitterapi.io — tweet downloads
# https://twitterapi.io
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here

# Anthropic — query expansion via Claude Haiku in hybrid+expansion adapter
ANTHROPIC_API_KEY=your_anthropic_key_here

# LiteLLM proxy — routes embeddings to Vertex AI via gcloud ADC.
# Start the proxy with: litellm --config eval/litellm_config.yaml --port 4000
# Requires: GOOGLE_APPLICATION_CREDENTIALS, VERTEXAI_PROJECT, VERTEXAI_LOCATION
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=                        # optional; leave blank for unauthenticated proxy

# Vertex AI credentials (used by LiteLLM proxy, not by the runner directly)
GOOGLE_APPLICATION_CREDENTIALS=/Users/yourname/.config/gcloud/application_default_credentials.json
VERTEXAI_PROJECT=finai-adhi-dev
VERTEXAI_LOCATION=us-central1

# gbrain embedding config — gemini-embedding-001 @ 1536 dims via Vertex AI
GBRAIN_EMBEDDING_MODEL=litellm:gemini-embedding-001
GBRAIN_EMBEDDING_DIMENSIONS=1536

# IBKR Flex Web Service — portfolio data
IBKR_FLEX_TOKEN=your_flex_token_here
IBKR_FLEX_QUERY_ID=your_query_id_here
