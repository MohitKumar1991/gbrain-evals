# FinanceBrain scraper keys — copy to .env.local and fill in values
# .env.local is gitignored; never commit real keys.

# Financial Modeling Prep — financials, price data, transcripts
# https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_key_here

# twitterapi.io — tweet downloads
# https://twitterapi.io
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here

# Anthropic — query expansion via Claude Haiku in hybrid+expansion adapter
ANTHROPIC_API_KEY=your_anthropic_key_here

# LiteLLM proxy — routes embeddings to Vertex AI (Google text-embedding-004)
# The proxy must be configured to forward requests to Vertex AI.
# See: https://docs.litellm.ai/docs/proxy/quick_start
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=                        # optional; leave blank if proxy is unauthenticated

# gbrain embedding config — tells the runner which model/dims to use.
# text-embedding-004 is Google's current recommended embedding model (768 dims).
# If your LiteLLM proxy exposes a different model name, set it here.
GBRAIN_EMBEDDING_MODEL=litellm:text-embedding-004
GBRAIN_EMBEDDING_DIMENSIONS=768

# IBKR Flex Web Service — portfolio data
IBKR_FLEX_TOKEN=your_flex_token_here
IBKR_FLEX_QUERY_ID=your_query_id_here
